# CarbonShift AI — `.gitignore`

# ── Secrets ───────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
backend/.env

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml
*.log

# ── Virtual envs ──────────────────────────────────────────────────────────────
venv/
.venv/
env/

# ── Node / Frontend ───────────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.local

# ── Database ──────────────────────────────────────────────────────────────────
*.db
*.sqlite3

# ── ML / Data ─────────────────────────────────────────────────────────────────
ml/models/*.joblib
ml/models/*.pkl
data/raw/*.parquet
data/processed/
data/holdout/

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
